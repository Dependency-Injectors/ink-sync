# Production Environment Variables
# Copy this file to .env and update the values

# Database
POSTGRES_PASSWORD=change_this_secure_password

# Backend
JWT_SECRET=change_this_to_a_random_64_character_string_for_production

# Frontend (update with your actual domain or EC2 public IP)
VITE_API_URL=http://your-domain-or-ip:3000
VITE_WS_URL=ws://your-domain-or-ip:3000

# For HTTPS/WSS (with SSL certificate):
# VITE_API_URL=https://your-domain.com
# VITE_WS_URL=wss://your-domain.com
